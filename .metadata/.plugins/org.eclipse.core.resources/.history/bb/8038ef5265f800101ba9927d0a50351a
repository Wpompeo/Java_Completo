package application;

import java.util.ArrayList;
import java.util.List;
import java.util.Locale;
import java.util.Scanner;

import entities.EmployeePayments;
import entities.OutsourcedEmployeePayments;

public class ProgramPayments {
	
	public static void main (String[] args) {
		
		Locale.setDefault(Locale.US);
		Scanner sc = new Scanner(System.in);
		
		List<EmployeePayments> list = new ArrayList<>();
		
		System.out.println("Enter the number of employess: ");
		
		int numberEmployess = sc.nextInt();
		
		for (int i=1; i<numberEmployess; i++) {
			System.out.println("Employee #" + i + " data: ");
			System.out.print("Outsourced (y/n)? ");
			char typeEmployess = sc.next().charAt(0);
			System.out.print("Name: ");
			sc.nextLine();
			String name = sc.nextLine();
			System.out.print("Hours: ");
			int hours = sc.nextInt();
			System.out.print("Value per hour: ");
			double valuePerHour = sc.nextDouble();
			
			if (typeEmployess == 'y') {
				System.out.print("Additional charge: ");
				
				double additionalCharge = sc.nextDouble();
				EmployeePayments emp = new OutsourcedEmployeePayments(name, hours, valuePerHour, additionalCharge);
				list.add(emp);
			}
			else {
				EmployeePayments emp = new EmployeePayments(name, hours, valuePerHour);
				list.add(emp);
			}
		}
		
		sc.close();
	}

}
